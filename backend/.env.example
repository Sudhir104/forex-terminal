# Copy to .env for local dev. On Render, set these as environment variables instead.

# --- core ---
DATABASE_URL=sqlite:///./forex.db
# Render/Supabase/Neon give you a postgres:// URL - paste it as-is, the app normalises it.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
# Shared secret for POST /api/internal/tick/{job} - required if you drive ingestion from
# GitHub Actions cron instead of the in-process scheduler (see .github/workflows/cron.yml).
CRON_TOKEN=change-me-too
ENABLE_SCHEDULER=true
# DEMO_MODE=true runs the whole app on synthetic data - no API keys needed. Good for a first look.
DEMO_MODE=false

# --- provider chains: first = primary, rest = fallback, in priority order ---
FX_PROVIDERS=twelvedata,frankfurter
MACRO_PROVIDERS=fred,ecb,boc,boe
NEWS_PROVIDERS=rss
CALENDAR_PROVIDERS=official

# --- free-tier keys (all free, no card required) ---
# https://twelvedata.com/pricing -> free Basic plan
TWELVEDATA_API_KEY=
TWELVEDATA_DAILY_CREDITS=800
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- paid-tier keys (optional, unlock consensus forecasts / faster news) ---
TRADINGECONOMICS_API_KEY=
FINNHUB_API_KEY=

# --- alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SCORE_MOVE=0.5

# --- AI explanation layer (optional; template explanations work with none of this set) ---
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
GROQ_API_KEY=
